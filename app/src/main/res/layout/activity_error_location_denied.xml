<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_background"
    android:padding="24dp">

    <!-- Center Card View for Error State -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/light_surface"
        app:cardCornerRadius="28dp"
        app:cardElevation="4dp"
        app:strokeColor="#FCA5A5"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp">

            <!-- Red Warning Alert Badge -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_badge"
                android:backgroundTint="#FEE2E2"
                android:contentDescription="@string/error_location_title"
                android:padding="18dp"
                android:src="@drawable/ic_warning_alert" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/error_location_title"
                android:textColor="#DC2626"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Subtitle/Explanation -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/error_location_desc"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <!-- Button: Try Again -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTryAgainLocation"
                style="@style/Widget.PadariaZero.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/btn_try_again" />

            <!-- Button: Type Address Manually -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManualAddress"
                style="@style/Widget.PadariaZero.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_manual_address" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>